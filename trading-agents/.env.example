# Copy to .env, chmod 600 .env. Never commit .env.

# SAFETY: stays 1 (shadow mode: decisions logged, no orders sent) until you deliberately set 0.
DRY_RUN=1

# Binance: trade-only key, NO withdrawal permission, IP-whitelisted to this VM.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1

# Moomoo OpenD (runs on this VM, localhost only)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_TRADE_PASSWORD=
MOOMOO_ENV=SIMULATE          # SIMULATE | REAL
MOOMOO_MARKET=US

# X signal feed (third-party, e.g. twitterapi.io)
X_FEED_API_KEY=
X_FEED_WS_URL=wss://ws.twitterapi.io/twitter/tweet/websocket

# Official X API bearer token: slow fallback poller for the watchlist
X_BEARER_TOKEN=

# Telegram alerts + /halt control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude Code CLI models
CLAUDE_FAST_MODEL=haiku
CLAUDE_TRADER_MODEL=sonnet
CLAUDE_BIN=claude
